{
  description = "Init Corsair Mouse";

  inputs = {
    nixpkgs.url = "github:nixos/nixpkgs?ref=nixos-unstable";
  };

  outputs = { self, nixpkgs, }: {
 nixosConfigurations.nixos = nixpkgs.lib.nixosSystem {
   system = "x86_64-linux";
    modules = [ ./configuration.nix ./hardware-configuration.nix ];
      };
    packages.x86_64-linux.initCorsairMouse =  let
        pkgs = import nixpkgs { system = "x86_64-linux"; };
        my-name = "initCorsairMouse";
        my-script = pkgs.writeShellScriptBin my-name ''
            /run/current-system/sw/bin/ckb-next-daemon &
            /run/current-system/sw/bin/ckb-next &
        '';
      in
      pkgs.symlinkJoin {
        name = my-name;
        paths = [ my-script ];
        buildInputs = [ pkgs.makeWrapper ];
        postBuild = "wrapProgram $out/bin/${my-name} --prefix PATH : $out/bin";
      };
    packages.x86_64-linux.default = self.packages.x86_64-linux.initCorsairMouse;

  };
}
