{
  description = "A very basic flake";

  inputs = {
    nixpkgs.url = "github:nixos/nixpkgs?ref=nixos-unstable";
  };

  outputs =
    { self, nixpkgs }:
    {
      nixosConfigurations.nixos = nixpkgs.lib.nixosSystem {
        system = "x86_64-linux";
        modules = [
          ./configuration.nix
          ./hardware-configuration.nix
        ];
      };
      packages.x86_64-linux.foo =
        let
          pkgs = import nixpkgs { system = "x86_64-linux"; };
          my-name = "foo";
          my-script = pkgs.writeShellScriptBin my-name ''
              RESET="\033[0m"
              BOLD="\033[1m"
              UNDERLINE="\033[4m"
              RED="\033[31m"
              GREEN="\033[32m"
              YELLOW="\033[33m"
              BLUE="\033[34m"
              BLUE0="\033[33m"
              CYAN="\033[36m"
              echo -e $BOLD$BLUE=== Montando Ramdisk ===$RESET
              umount /ram/code -fl
             mkdir -p /ram/code; mount -t tmpfs -o size=32G,mode=1777 ram_code /ram/code
              echo -e $GREEN
              rsync -rulth -n --chmod=777 --chown=leo:users --size-only --stats   /kali/home/leo/code /ram
              echo -e $RESET
              read -rp "Rsync? (y/n): " -n 1 response
               echo "" # Moves cursor to a new line
              case "$response" in
                [yY][eE][sS]|[yY])
                    echo -e $YELLOW
                    rsync -rulthv --chmod=777 --chown=leo:users --size-only --stats  /kali/home/leo/code /ram
                    ;;
                *)
                    echo -e "$RED 🍄‍🟫  Code > RAM skipped $RESET "
                    ;;
            esac
            echo  -e "$RESET\n"
             read -rp "Pull Git? (y/n): " -n 1 response
              echo "" # Moves cursor to a new line
              case "$response" in
                  [yY][eE][sS]|[yY])
                      echo -e "$BLUE0 Proceeding..."
                      cd /ram/code/fibo
                      git pull
                      ;;
                  *)
                      echo "Action aborted."
                      exit 1
                      ;;
              esac
          '';
          my-buildInputs = with pkgs; [
            cowsay
            ddate
          ];
        in
        pkgs.symlinkJoin {
          name = my-name;
          paths = [ my-script ] ++ my-buildInputs;
          buildInputs = [ pkgs.makeWrapper ];

          postBuild = "wrapProgram $out/bin/${my-name} --prefix PATH : $out/bin";
        };
      packages.x86_64-linux.default = self.packages.x86_64-linux.foo;inputactions-standalone.packages.${pkgs.system}.default

    };
}
