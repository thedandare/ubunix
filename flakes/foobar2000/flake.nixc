{
  description = "Foobar via Wine";

  inputs = {
    erosanix.url = "github:emmanuelrosa/erosanix";
  };

  ouputs =
    {
      self,
      nixpkgs,
      erosanix,
      ...
    }:
    {
      nixosConfigurations.nixos = nixpkgs.lib.nixosSystem {
        system = "x86_64-linux";
        modules = [
          ./configuration.nix
        ];
      };
      packages.x86_64-linux.foobar2000 = erosanix.nixosModules.foobar2000;
      packages.x86_64-linux.default = self.packages.x86_64-linux.foobar2000;

    };
}
