- id: 797bdaf1-2fc1-47a1-bc9e-8adfe21dabc6
  type: run
  props:
    type: bash
    name: Terminal 1
    code: |
      microk8s helm dashboard --bind 0.0.0.0 --no-browser --port 8082
    pty: ''
