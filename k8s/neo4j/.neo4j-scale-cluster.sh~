#!/bin/sh
set -eu

#
# ============================================================
# Neo4j - converter standalone existente em cluster de 3 nós
# ============================================================
#
# Pré-condições:
#
# - O primeiro deploy já existe e está funcionando.
# - O banco neo4j já foi restaurado pelo primeiro script.
# - O values.yaml usado no primeiro deploy está disponível.
# - Neo4j Enterprise.
#
# Este script NÃO:
#
# - remove o primeiro release;
# - remove o primeiro PVC;
# - restaura novamente o banco neo4j.
#
# Ele:
#
# 1. Coloca o servidor existente offline.
# 2. Faz dump do banco "system".
# 3. Configura minimumClusterSize=3.
# 4. Cria dois novos servidores com PVCs novos.
# 5. Restaura o mesmo "system" nos novos servidores.
# 6. Inicia os três servidores juntos.
# 7. Aguarda formação do cluster.
#

VM="leonk7s"
NAMESPACE="neo4j"

VALUES="values.yaml"

#
# Release que já existe.
#
SERVER1="my-neo4j-release"

#
# Novos releases.
#
SERVER2="my-neo4j-release-2"
SERVER3="my-neo4j-release-3"

#
# Kubernetes nodes onde cada Neo4j ficará.
#
NODE1="leonk7s"
NODE2="leonk8s"
NODE3="leonk9s"

#
# Neo4j.
#
NEO4J_USER="neo4j"
NEO4J_PASSWORD="F1bo6600"

SYSTEM_DUMP="system.dump"

REMOTE_VALUES="/root/values.yaml"
REMOTE_SYSTEM_DUMP="/root/$SYSTEM_DUMP"

OVERRIDE1="/root/neo4j-cluster-server1.yaml"
OVERRIDE2="/root/neo4j-cluster-server2.yaml"
OVERRIDE3="/root/neo4j-cluster-server3.yaml"


echo
echo "============================================================"
echo " NEO4J - CONVERSÃO STANDALONE -> CLUSTER DE 3 SERVIDORES"
echo "============================================================"
echo
echo "Servidor 1: $SERVER1 -> $NODE1"
echo "Servidor 2: $SERVER2 -> $NODE2"
echo "Servidor 3: $SERVER3 -> $NODE3"
echo


#
# ============================================================
# 1. VALIDAR VALUES.YAML
# ============================================================
#

if [ ! -f "$VALUES" ]; then
    echo "ERRO: $VALUES não encontrado."
    exit 1
fi


#
# ============================================================
# 2. VALIDAR PRIMEIRO RELEASE
# ============================================================
#

echo "=== Verificando primeiro servidor ==="

if ! incus exec "$VM" -- \
    microk8s helm status "$SERVER1" \
    -n "$NAMESPACE" \
    >/dev/null 2>&1
then
    echo
    echo "ERRO: release $SERVER1 não encontrado."
    exit 1
fi

echo "OK: $SERVER1 existe."


#
# ============================================================
# 3. GARANTIR QUE OS NOVOS RELEASES AINDA NÃO EXISTEM
# ============================================================
#

for RELEASE in "$SERVER2" "$SERVER3"
do
    if incus exec "$VM" -- \
        microk8s helm status "$RELEASE" \
        -n "$NAMESPACE" \
        >/dev/null 2>&1
    then
        echo
        echo "ERRO: o release $RELEASE já existe."
        echo "Não vou modificá-lo automaticamente."
        exit 1
    fi
done


#
# ============================================================
# 4. MOSTRAR ESTADO ATUAL
# ============================================================
#

echo
echo "=== Estado atual ==="

incus exec "$VM" -- \
    microk8s helm list \
    -n "$NAMESPACE"

echo

incus exec "$VM" -- \
    microk8s kubectl get pods \
    -n "$NAMESPACE" \
    -o wide


#
# ============================================================
# 5. COPIAR VALUES.YAML PARA VM ADMINISTRADORA
# ============================================================
#

echo
echo "=== Copiando values.yaml ==="

incus file push \
    "$VALUES" \
    "$VM$REMOTE_VALUES"


#
# ============================================================
# 6. CRIAR OVERRIDES PARA CADA SERVIDOR
# ============================================================
#
# Todos usam:
#
#   minimumClusterSize: 3
#
# Todos começam em:
#
#   offlineMaintenanceModeEnabled: true
#
# Isso permite preparar os três antes de iniciar o cluster.
#

echo
echo "=== Criando configurações dos três servidores ==="


incus exec "$VM" -- sh -c "cat > '$OVERRIDE1' <<'EOF'
neo4j:
  minimumClusterSize: 3
  offlineMaintenanceModeEnabled: true

nodeSelector:
  kubernetes.io/hostname: leonk7s
EOF"


incus exec "$VM" -- sh -c "cat > '$OVERRIDE2' <<'EOF'
neo4j:
  minimumClusterSize: 3
  offlineMaintenanceModeEnabled: true

nodeSelector:
  kubernetes.io/hostname: leonk8s
EOF"


incus exec "$VM" -- sh -c "cat > '$OVERRIDE3' <<'EOF'
neo4j:
  minimumClusterSize: 3
  offlineMaintenanceModeEnabled: true

nodeSelector:
  kubernetes.io/hostname: leonk9s
EOF"


#
# ============================================================
# 7. COLOCAR PRIMEIRO SERVIDOR OFFLINE
# ============================================================
#
# IMPORTANTE:
#
# O PVC original NÃO é apagado.
#
# O banco neo4j continua intacto.
#
# Apenas paramos o Neo4j para poder fazer dump consistente
# do banco "system".
#

echo
echo "============================================================"
echo " COLOCANDO SERVIDOR 1 EM MAINTENANCE MODE"
echo "============================================================"

incus exec "$VM" -- \
    microk8s helm upgrade "$SERVER1" neo4j/neo4j \
    -n "$NAMESPACE" \
    --reuse-values \
    -f "$OVERRIDE1"


#
# ============================================================
# 8. AGUARDAR POD 1 FICAR RUNNING
# ============================================================
#
# Não esperamos READY porque está em maintenance mode.
#

POD1="${SERVER1}-0"

echo
echo "=== Aguardando $POD1 ficar Running em $NODE1 ==="

i=0

while :
do

    STATUS=$(
        incus exec "$VM" -- \
            microk8s kubectl get pod "$POD1" \
            -n "$NAMESPACE" \
            -o jsonpath='{.status.phase}' \
            2>/dev/null || true
    )

    NODE=$(
        incus exec "$VM" -- \
            microk8s kubectl get pod "$POD1" \
            -n "$NAMESPACE" \
            -o jsonpath='{.spec.nodeName}' \
            2>/dev/null || true
    )

    echo "Pod: $POD1 | Status: ${STATUS:-?} | Node: ${NODE:-?}"

    if [ "$STATUS" = "Running" ] && [ "$NODE" = "$NODE1" ]; then
        break
    fi

    i=$((i + 1))

    if [ "$i" -gt 180 ]; then
        echo
        echo "ERRO: timeout aguardando servidor 1."
        exit 1
    fi

    sleep 2

done


#
# ============================================================
# 9. CRIAR DIRETÓRIO DE BACKUP
# ============================================================
#

echo
echo "=== Preparando /backups ==="

incus exec "$VM" -- \
    microk8s kubectl exec \
    -n "$NAMESPACE" \
    "$POD1" \
    -- mkdir -p /backups


#
# ============================================================
# 10. DUMP DO BANCO SYSTEM
# ============================================================
#

echo
echo "============================================================"
echo " CRIANDO DUMP DO BANCO SYSTEM"
echo "============================================================"

#
# Remove dump antigo, caso exista.
#

incus exec "$VM" -- \
    microk8s kubectl exec \
    -n "$NAMESPACE" \
    "$POD1" \
    -- rm -f "/backups/$SYSTEM_DUMP"


#
# Cria novo dump.
#

incus exec "$VM" -- \
    microk8s kubectl exec \
    -n "$NAMESPACE" \
    "$POD1" \
    -- neo4j-admin database dump \
    --expand-commands \
    system \
    --to-path=/backups


#
# Conferir.
#

incus exec "$VM" -- \
    microk8s kubectl exec \
    -n "$NAMESPACE" \
    "$POD1" \
    -- ls -lh /backups


#
# ============================================================
# 11. COPIAR SYSTEM.DUMP PARA A VM
# ============================================================
#

echo
echo "=== Copiando system.dump para $VM ==="

incus exec "$VM" -- \
    microk8s kubectl cp \
    "$NAMESPACE/$POD1:/backups/$SYSTEM_DUMP" \
    "$REMOTE_SYSTEM_DUMP"


#
# ============================================================
# 12. INSTALAR SERVIDOR 2 OFFLINE
# ============================================================
#

echo
echo "============================================================"
echo " INSTALANDO SERVIDOR 2 EM $NODE2"
echo "============================================================"

incus exec "$VM" -- \
    microk8s helm install "$SERVER2" neo4j/neo4j \
    -n "$NAMESPACE" \
    -f "$REMOTE_VALUES" \
    -f "$OVERRIDE2"


#
# ============================================================
# 13. INSTALAR SERVIDOR 3 OFFLINE
# ============================================================
#

echo
echo "============================================================"
echo " INSTALANDO SERVIDOR 3 EM $NODE3"
echo "============================================================"

incus exec "$VM" -- \
    microk8s helm install "$SERVER3" neo4j/neo4j \
    -n "$NAMESPACE" \
    -f "$REMOTE_VALUES" \
    -f "$OVERRIDE3"


POD2="${SERVER2}-0"
POD3="${SERVER3}-0"


#
# ============================================================
# 14. AGUARDAR NOVOS PODS FICAREM RUNNING
# ============================================================
#

wait_running()
{

    POD="$1"
    EXPECTED_NODE="$2"

    echo
    echo "=== Aguardando $POD em $EXPECTED_NODE ==="

    i=0

    while :
    do

        STATUS=$(
            incus exec "$VM" -- \
                microk8s kubectl get pod "$POD" \
                -n "$NAMESPACE" \
                -o jsonpath='{.status.phase}' \
                2>/dev/null || true
        )

        NODE=$(
            incus exec "$VM" -- \
                microk8s kubectl get pod "$POD" \
                -n "$NAMESPACE" \
                -o jsonpath='{.spec.nodeName}' \
                2>/dev/null || true
        )

        echo "Pod: $POD | Status: ${STATUS:-?} | Node: ${NODE:-?}"

        if [ "$STATUS" = "Running" ] && \
           [ "$NODE" = "$EXPECTED_NODE" ]; then
            break
        fi

        i=$((i + 1))

        if [ "$i" -gt 180 ]; then
            echo
            echo "ERRO: timeout aguardando $POD."
            exit 1
        fi

        sleep 2

    done
}


wait_running "$POD2" "$NODE2"
wait_running "$POD3" "$NODE3"


#
# ============================================================
# 15. COPIAR SYSTEM.DUMP PARA SERVIDOR 2
# ============================================================
#

echo
echo "=== Restaurando system no servidor 2 ==="

incus exec "$VM" -- \
    microk8s kubectl exec \
    -n "$NAMESPACE" \
    "$POD2" \
    -- mkdir -p /backups


incus exec "$VM" -- \
    microk8s kubectl cp \
    "$REMOTE_SYSTEM_DUMP" \
    "$NAMESPACE/$POD2:/backups/$SYSTEM_DUMP"


incus exec "$VM" -- \
    microk8s kubectl exec \
    -n "$NAMESPACE" \
    "$POD2" \
    -- neo4j-admin database load \
    --expand-commands \
    system \
    --from-path=/backups \
    --overwrite-destination=true


#
# ============================================================
# 16. COPIAR SYSTEM.DUMP PARA SERVIDOR 3
# ============================================================
#

echo
echo "=== Restaurando system no servidor 3 ==="

incus exec "$VM" -- \
    microk8s kubectl exec \
    -n "$NAMESPACE" \
    "$POD3" \
    -- mkdir -p /backups


incus exec "$VM" -- \
    microk8s kubectl cp \
    "$REMOTE_SYSTEM_DUMP" \
    "$NAMESPACE/$POD3:/backups/$SYSTEM_DUMP"


incus exec "$VM" -- \
    microk8s kubectl exec \
    -n "$NAMESPACE" \
    "$POD3" \
    -- neo4j-admin database load \
    --expand-commands \
    system \
    --from-path=/backups \
    --overwrite-destination=true


#
# ============================================================
# 17. INICIAR OS TRÊS SERVIDORES
# ============================================================
#

echo
echo "============================================================"
echo " INICIANDO CLUSTER"
echo "============================================================"


echo
echo "=== Iniciando servidor 1 ==="

incus exec "$VM" -- \
    microk8s helm upgrade "$SERVER1" neo4j/neo4j \
    -n "$NAMESPACE" \
    --reuse-values \
    --set neo4j.offlineMaintenanceModeEnabled=false


echo
echo "=== Iniciando servidor 2 ==="

incus exec "$VM" -- \
    microk8s helm upgrade "$SERVER2" neo4j/neo4j \
    -n "$NAMESPACE" \
    --reuse-values \
    --set neo4j.offlineMaintenanceModeEnabled=false


echo
echo "=== Iniciando servidor 3 ==="

incus exec "$VM" -- \
    microk8s helm upgrade "$SERVER3" neo4j/neo4j \
    -n "$NAMESPACE" \
    --reuse-values \
    --set neo4j.offlineMaintenanceModeEnabled=false


#
# ============================================================
# 18. AGUARDAR OS TRÊS STATEFULSETS
# ============================================================
#

echo
echo "============================================================"
echo " AGUARDANDO CLUSTER FICAR READY"
echo "============================================================"


incus exec "$VM" -- \
    microk8s kubectl rollout status \
    "statefulset/$SERVER1" \
    -n "$NAMESPACE" \
    --timeout=600s


incus exec "$VM" -- \
    microk8s kubectl rollout status \
    "statefulset/$SERVER2" \
    -n "$NAMESPACE" \
    --timeout=600s


incus exec "$VM" -- \
    microk8s kubectl rollout status \
    "statefulset/$SERVER3" \
    -n "$NAMESPACE" \
    --timeout=600s


#
# ============================================================
# 19. MOSTRAR DISTRIBUIÇÃO
# ============================================================
#

echo
echo "============================================================"
echo " PODS DO CLUSTER"
echo "============================================================"

incus exec "$VM" -- \
    microk8s kubectl get pods \
    -n "$NAMESPACE" \
    -o wide


#
# ============================================================
# 20. VERIFICAR SERVIDORES NEO4J
# ============================================================
#

echo
echo "============================================================"
echo " SHOW SERVERS"
echo "============================================================"

incus exec "$VM" -- \
    microk8s kubectl exec \
    -n "$NAMESPACE" \
    "$POD1" \
    -- cypher-shell \
    -u "$NEO4J_USER" \
    -p "$NEO4J_PASSWORD" \
    -d system \
    "SHOW SERVERS;"


#
# ============================================================
# 21. VERIFICAR DATABASES
# ============================================================
#

echo
echo "============================================================"
echo " SHOW DATABASES"
echo "============================================================"

incus exec "$VM" -- \
    microk8s kubectl exec \
    -n "$NAMESPACE" \
    "$POD1" \
    -- cypher-shell \
    -u "$NEO4J_USER" \
    -p "$NEO4J_PASSWORD" \
    -d system \
    "SHOW DATABASES;"


echo
echo "============================================================"
echo " CLUSTER NEO4J CRIADO"
echo "============================================================"
echo
echo "$SERVER1 -> $NODE1"
echo "$SERVER2 -> $NODE2"
echo "$SERVER3 -> $NODE3"
echo
